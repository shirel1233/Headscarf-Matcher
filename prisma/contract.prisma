// use prisma-8

model Dress {
  id        Uuid               @id @default(uuid())
  name      String
  color     String
  style     String?
  imageUrl  String?
  inStock   Boolean            @default(true)
  createdAt TimestamptzJsDate  @default(now())

  @@map("dress")
}
model Scarf {
  id          Uuid               @id @default(uuid())
  name        String
  color       String
  pattern     String?
  imageUrl    String?
  purchaseUrl String             @unique
  designer    String?
  price       Numeric(10, 2)?
  currency    String?
  inStock     Boolean            @default(true)
  externalId  String?
  lastSeenAt  TimestamptzJsDate?
  createdAt   TimestamptzJsDate  @default(now())

  @@map("scarf")
}